// Hello World multi-model steer mission orchestrating 4 distinct NVIDIA Nemotron
// models on Nebius Token Factory in sequence:
//   1. Nemotron 3 Ultra     ([model:ultra]     -> nvidia/Nemotron-3-Ultra-550b-a55b)
//   2. Nemotron 3 Super     ([model:super]     -> nvidia/nemotron-3-super-120b-a12b)
//   3. Nemotron 3 Nano      ([model:nano]      -> nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B)
//   4. Nemotron 3.5 Lightning ([model:lightning] -> nvidia/Nemotron-3_5-Lightning)
//
// Run live on Nebius Token Factory:
//   uta mission run examples/hello-nemotron/hello-nemotron.steer
//
// Run deterministic offline test:
//   uta mission test examples/hello-nemotron/hello-nemotron.steer --script examples/hello-nemotron/hello-nemotron.journal.yaml

agent fn ultra_plan(topic: Text) -> Text
  worker any(nebius, claude, agy)
  costs <= 40k tokens
  prompt """
  [model:ultra] You are NVIDIA Nemotron 3 Ultra (550B/55B MoE) on Nebius Token Factory.
  In one concise sentence, outline the 90/10 multi-agent plan for: ${topic}.
  """

agent fn super_implement(plan: Text) -> Text
  worker any(nebius, claude, agy)
  costs <= 40k tokens
  prompt """
  [model:super] You are NVIDIA Nemotron 3 Super (120B/12B MoE) on Nebius Token Factory.
  Given the Ultra plan (${plan}), reply in one concise sentence with how the parallel worker swarm implements it.
  """

agent fn nano_compact(plan: Text, impl: Text) -> Text
  worker any(nebius, claude, agy)
  costs <= 30k tokens
  prompt """
  [model:nano] You are NVIDIA Nemotron 3 Nano (30B/3B MoE) on Nebius Token Factory.
  Compact the Ultra plan (${plan}) and Super implementation (${impl}) into a two-line executive summary.
  """

agent fn lightning_guardrail(summary: Text) -> Text
  worker any(nebius, claude, agy)
  costs <= 30k tokens
  prompt """
  [model:lightning] You are NVIDIA Nemotron 3.5 Lightning on Nebius Token Factory.
  Verify the summary (${summary}) against OWASP Agentic ASI01-ASI10 and emit a final PASS verdict with the summary.
  """

mission hello_nemotron_models {
  budget 150k tokens, $1, 3min
  let p = ultra_plan("Hello World Multi-Model Agent Fleet")
  let impl = super_implement(p)
  let summary = nano_compact(p, impl)
  let verdict = lightning_guardrail(summary)
  emit verdict
}
